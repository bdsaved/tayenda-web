# Copy to .env for local development. Defaults below are for development only;
# with ENVIRONMENT=production the server refuses to start on default secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/tayenda
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
STORAGE_PATH=./storage
WEB_CLIENT_ORIGIN=http://localhost:3000
PUBLIC_WEB_ORIGIN=https://tayenda.renai-labs.com
NGROK_ORIGIN=
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-me
OPERATOR_EMAIL=admin@tayenda.local
PROCESS_INTERVAL_SECONDS=120
# Raw phone files of processed trips are deleted after this many days.
# Road segments and hazards are kept in the database. 0 keeps files forever.
RAW_RETENTION_DAYS=30

# Roughness model (RMS vertical acceleration, m/s^2). Recalibrate after field validation.
ROUGHNESS_FAIR=0.8
ROUGHNESS_POOR=1.6
JOLT_THRESHOLD=10.0
