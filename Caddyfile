# Nginx Proxy Manager terminates HTTPS.
# This Caddy instance is only an internal HTTP router for one-domain routing.
:80 {
  encode gzip zstd

  handle /api/* {
    reverse_proxy server:8000
  }

  handle /docs* {
    reverse_proxy server:8000
  }

  handle /openapi.json {
    reverse_proxy server:8000
  }

  handle /health {
    reverse_proxy server:8000
  }

  handle /_build/* {
    header Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy client:3000
  }

  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy client:3000
  }

  handle /favicon.ico {
    respond 204
  }

  handle {
    header Cache-Control "no-store"
    reverse_proxy client:3000
  }
}
