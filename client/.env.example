# API origin the dashboard talks to (the app appends /api/v1; see app/lib/api.ts).
# Local backend (uvicorn default port):
VITE_API_URL=http://localhost:8000
# Production one-domain deployment (Caddy routes /api/* to FastAPI): leave empty
# for same-origin relative requests.
# VITE_API_URL=

# Optional map tiles (defaults to OpenStreetMap standard tiles).
# Base map. Default is OpenStreetMap. To use Mapbox instead, set a public
# (pk.) token, restricted to your dashboard URL in the Mapbox account:
# VITE_MAPBOX_TOKEN=pk.xxxx
# VITE_MAPBOX_STYLE=mapbox/streets-v12      # or mapbox/satellite-streets-v12
# Or any other XYZ tile server:
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

VITE_PUBLIC_WEB_URL=https://tayenda.renai-labs.com
