# Nginx Proxy Manager terminates HTTPS.
# This Caddy instance is only an internal HTTP router for one-domain routing.
:80 {
  encode gzip zstd

  handle /api/* {
    reverse_proxy server:8000
  }

  handle /docs* {
    reverse_proxy server:8000
  }

  handle /openapi.json {
    reverse_proxy server:8000
  }

  handle /health {
    reverse_proxy server:8000
  }

  # Android app downloads: ./downloads on the host is mounted at /srv/downloads.
  handle /downloads/* {
    root * /srv
    @apk path *.apk
    header @apk Content-Type application/vnd.android.package-archive
    header @apk Content-Disposition `attachment; filename="tayenda.apk"`
    header @apk Cache-Control "public, max-age=3600"
    @meta path /downloads/latest.json
    header @meta Cache-Control "no-store"
    file_server
  }

  # Page images: long cache so a CDN or browser can keep them.
  handle /media/* {
    header Cache-Control "public, max-age=604800"
    reverse_proxy client:3000
  }

  handle /_build/* {
    header Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy client:3000
  }

  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy client:3000
  }

  handle /favicon.ico {
    respond 204
  }

  handle {
    header Cache-Control "no-store"
    reverse_proxy client:3000
  }
}
