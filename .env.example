# Copy to web/.env on the production host. Used by docker-compose.yml.
PUBLIC_DOMAIN=tayenda.renai-labs.com
NPM_UPSTREAM_PORT=3001

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OPERATOR_USERNAME=admin
# Required. On first start this replaces the old default admin password.
OPERATOR_PASSWORD=
OPERATOR_EMAIL=

# Only takes effect when the Postgres volume is first created.
POSTGRES_PASSWORD=password

# Days to keep raw phone files after processing (0 = forever).
RAW_RETENTION_DAYS=30

# Optional Mapbox base map (public pk. token). Leave empty for OpenStreetMap.
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/streets-v12
